# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real credentials.
#
# Local development reads these via server/index.js (dotenv).
# On Vercel: Project Settings -> Environment Variables (same names).

# Local API port (Vite proxies /api here during development)
PORT=3001

# Supabase — server-side access (server/config/supabase.js).
# The backend falls back to the VITE_* values below if these are unset,
# but on Vercel you should set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# so the service-role key never reaches the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign auth session cookies (server/utils/session.js).
# Any long random string works. If unset, the server falls back to the
# Supabase keys above (and to an unstable secret if those are missing too).
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase — browser/client use (src/lib/supabase.js)
# Client-side should use ONLY the anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

